{
  "buildCommand": "curl -sL https://github.com/gohugoio/hugo/releases/download/v0.136.5/hugo_extended_0.136.5_linux-amd64.tar.gz | tar xz -C /usr/local/bin && hugo --gc --minify",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/posts/(.*)",
      "destination": "/posts/$1/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}