{
  "buildCommand": "hugo --gc --minify",
  "outputDirectory": "public",
  "env": {
    "HUGO_VERSION": "0.136.5"
  },
  "rewrites": [
    {
      "source": "/posts/(.*)",
      "destination": "index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
